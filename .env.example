# Default: a working local GUEST test-order demo, not fake local authentication.
ORDER_STORAGE=local
# DATA_DIR=./data

# Your existing Supabase setup (keep your actual values in .env.local):
# ORDER_STORAGE=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_KEY
# A legacy service-role key may use SUPABASE_SERVICE_ROLE_KEY instead.
# The base URL must NOT include /rest/v1, a table path or query parameters.

# v0.4 customer authentication: a DIFFERENT key from the same project.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
# Do not replace the server secret with this value. Both keys serve different roles.
# Auth calls run through our Next.js server with HttpOnly cookies, so neither key
# needs a NEXT_PUBLIC_ prefix in this implementation.

# Apply the account ownership SQL migration and configure the email template.
# See AUTH-SETUP.md. No project, user account, SMTP or payment is pre-connected.
# Payments (server-only secret; never expose or commit the live secret)
# PAYSTACK_SECRET_KEY=sk_live_...
# The public site URL must be the production URL used by Paystack callbacks.
# NEXT_PUBLIC_SITE_URL=https://jie-plate-git-main-goody020s-projects.vercel.app

# Shipbubble server-only delivery API key.
# SHIPBUBBLE_API_KEY=your_shipbubble_live_api_key
# SHIPBUBBLE_CATEGORY_ID=69709726
# SHIPBUBBLE_PICKUP_PHONE=+2349131246555

NEXT_TELEMETRY_DISABLED=1

# Required for Google Places + draggable maps on HTTPS / localhost.
# Enable Maps JavaScript API, Places API and Geocoding API; restrict browser key to allowed origins.
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_restricted_browser_key
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_project_anon_key
# Set NEXT_PUBLIC_SITE_URL to http://localhost:3000 for local testing.
